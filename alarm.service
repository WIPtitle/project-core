[Unit]
Description=Docker Compose Application Service
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/project-core
ExecStart=/usr/bin/docker compose -f /home/pi/project-core/docker-compose.yaml up -d --build
ExecStop=/usr/bin/docker compose -f /home/pi/project-core/docker-compose.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target